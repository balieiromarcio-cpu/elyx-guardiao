# Banco (Neon Postgres — projeto NOVO, separado dos outros apps)
DATABASE_URL=

# NextAuth v5
AUTH_SECRET=

# Autoriza as rotas /api/cron/* (Vercel manda "Authorization: Bearer <valor>")
CRON_SECRET=

# Vercel Blob — documentos de rótulo/laudo anexados às versões, identidade visual, exportação semanal
BLOB_READ_WRITE_TOKEN=

# Seed do usuário admin inicial (prisma/seed.ts)
ADMIN_EMAIL=elyxnutrition@gmail.com
ADMIN_PASSWORD=

# Shopify — app "Guardiao Elyx" criado no Dev Dashboard (dev.shopify.com), escopo read_products.
# A loja não emite mais token estático: instala-se pela Shopify (botão "Instalar app"), que
# redireciona pra /api/shopify/callback e o próprio Guardião troca o código pelo token e
# guarda no banco (ShopifyConnection) — só estas duas credenciais do app vão em env var.
# "ID do cliente" e "Chave secreta" ficam em Configurações do app → Credenciais no Dev Dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Fallback manual (se algum dia a Shopify voltar a emitir token direto de app customizado):
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# E-mail transacional (mesmo provedor do elyx-associadas — Resend, HTTP puro)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# separados por vírgula — quem recebe aviso de mudança de fato/claim
NOTIFY_EMAILS=elyxnutrition@gmail.com

# "Perguntar ao Guardião" (fase 2) e extração de rótulo por foto (fase 1c)
ANTHROPIC_API_KEY=
